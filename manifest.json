{
  "manifest_version": 3,
  "name": "AI-Less Habr",
  "short_name": "AILessHabr",
  "version": "2026.10.11.0",
  "author": "seriych",
  "description": "Hides AI articles on habr.com",
  "icons": {
     "16": "icons/icon16.png",
     "32": "icons/icon32.png",
     "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": ["storage", "tabs"],
  "action": {
    "default_popup": "popup.html"
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://habr.com/*/feed/page*",
        "https://habr.com/*/feed/",
        "https://habr.com/*/articles/page*",
        "https://habr.com/*/articles/",
        "https://habr.com/*/posts/page*",
        "https://habr.com/*/posts/",
        "https://habr.com/*/news/page*",
        "https://habr.com/*/news/",
        "https://habr.com/*/packs/daily/",
        "https://habr.com/*/packs/daily/*"
      ],
      "js": ["config.js", "ml-models.js", "content.js"],
      "run_at": "document_end"
    }
  ]
}
